# Copia este archivo como .env y llena los valores de TU proyecto de Supabase
# (Supabase > Project Settings > API). El archivo .env está en .gitignore.
#
# Si dejas estos valores vacíos, la web arranca en "modo demostración":
# los datos se guardan solo en tu navegador (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
